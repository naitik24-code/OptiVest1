# OptiVest AI Master Environment Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=optivest_db
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_dev@database:5432/optivest_db

# Security & JWT Token Config
JWT_SECRET=super_secret_jwt_key_change_in_production_environment_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Config
VITE_API_BASE_URL=http://localhost:8000/api/v1
